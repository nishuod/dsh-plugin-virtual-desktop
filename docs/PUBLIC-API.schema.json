      ]
    }
  },
  {
    "name": "desktop_reset_child_session",
    "description": "幂等重置本插件拥有的 PiP/孤儿子会话。只接受可选 operationId；未连接成功返回 state=idle，完成自有清理返回 state=released 与 releasedPids。相同 operationId 返回原回执，不会关闭后来建立的连接。撤销旧帧和授权；不终止其它进程或会话，不授予新权限。",
    "parameters": {
      "type": "object",
      "properties": {
        "operationId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "desktop_restore_window",
    "description": "恢复已授权目标窗口，不需要截图或 frameId。传入 desktop_get_task_status 的 connectionId、epoch、windowId 和 pid；独立核验当前权限与目标身份。确认稳定几何后返回 state=restored、verified=true；超过等待时限返回 state=restoring 和 retryAfterMs，不附带窗口几何。按 nextTool 调用 desktop_get_screenshot 取得新帧。",
    "parameters": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "connectionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
