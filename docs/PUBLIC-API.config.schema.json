{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "visualCandidates": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "maxCandidates": {
          "default": 8,
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "budgetMs": {
          "default": 120,
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "minRegionHeightPx": {
          "default": 32,
          "type": "integer",
          "minimum": 24,
          "maximum": 256
        },
        "maxRegionAspectRatio": {
          "default": 8,
          "type": "number",
          "minimum": 1,
          "maximum": 32
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": {},
  "title": "Desktop visual candidate configuration"
}
